<?xml version="1.0" encoding="utf-8"?>
<!-- Cards in Stouthart's palette, with Android's own views and shapes: no library, no extra inflation cost. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Device card -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text2"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Current codec; everything that needs Bluetooth starts hidden or greyed until show() fills it. -->
            <LinearLayout
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/panel"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/current_codec"
                    android:textAllCaps="true"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <!-- The Play/Pause button sits in this row, so the specs line below has the full width. At its height
                     whether it shows or not, so the panel doesn't jump when it comes or goes. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/codec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_text"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <!-- Green, as a lock's line; its text in the ground's colour: white on the light green (5.1:1),
                         near-black on the dark one (9.3:1). -->
                    <TextView
                        android:id="@+id/hi_res"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/pill"
                        android:backgroundTint="@color/success"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/hi_res"
                        android:textColor="@color/bg"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- While a music app plays or waits: the key a headset's button sends. Whole: a negative margin
                         would have the row cut the circle's top and bottom off. -->
                    <ImageView
                        android:id="@+id/play"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/circle"
                        android:contentDescription="@string/play"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@drawable/ic_play"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 8dp: room below the Play/Pause circle, which reaches the row's foot. -->
                <TextView
                    android:id="@+id/spec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />

                <!-- RedMagic only: what its fixed mixer resamples, under the format it runs; a second resample in orange. -->
                <TextView
                    android:id="@+id/note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text2"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pair"
                style="@style/Button"
                android:layout_marginTop="20dp"
                android:text="@string/pair"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Lock section -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Title"
                        android:text="@string/lock_title" />

                    <TextView
                        android:id="@+id/summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_marginTop="20dp"
                android:text="@string/sample_rate" />

            <!-- A 40dp icon slot, the slider, the value at the end. -11dp at the start: the bars, drawn 3dp into their
                 box, start on the label's line. The box reaches 11dp above and below the bars and the slider, so -1dp
                 at the top and -11dp at the foot count the margins from what shows: 10dp from the label, as Quality's
                 segments are, and 20dp to what follows. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:layout_marginBottom="-11dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="-11dp"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_bars" />

                <!-- 0..3 for 44.1, 48, 88.2 and 96 kHz. -->
                <SeekBar
                    android:id="@+id/rate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/sample_rate"
                    android:max="3"
                    android:progressBackgroundTint="@color/text2"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <TextView
                    android:id="@+id/rate_value"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_marginTop="28dp"
                android:text="@string/quality" />

            <!-- HIGH and MID, labelled with their kbps at the chosen rate (909/606 or 990/660). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quality_high"
                    style="@style/Segment"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/quality_mid"
                    style="@style/Segment" />
            </LinearLayout>

            <TextView
                android:id="@+id/lock"
                style="@style/Button"
                android:layout_marginTop="16dp"
                android:alpha="0.5"
                android:enabled="false"
                android:text="@string/lock_now" />

            <TextView
                android:id="@+id/last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:textColor="@color/text2"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Settings: the title row opens and closes the card; closed at first, then as it was left. The title row
             reaches over the card's padding to its edges, so the card leaves its padding unclipped, and clips to its own
             rounded outline: the ripple fills the card closed, its title band open, corners and all. -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="16dp"
            android:animateLayoutChanges="true"
            android:clipToOutline="true"
            android:clipToPadding="false">

            <!-- No bar: it marks a title with a summary line, as on Lock; Settings is a title alone. -->
            <!-- To tap, the whole card while closed, as a room's row is all of it: -20dp margins over the card's padding
                 to its edges, with 20dp padding back, so the title and the chevron stay where they were, and 68dp, the
                 closed card's height (each side apart: Android ignores a negative layout_marginVertical). -->
            <LinearLayout
                android:id="@+id/settings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-20dp"
                android:layout_marginTop="-20dp"
                android:layout_marginEnd="-20dp"
                android:layout_marginBottom="-20dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="68dp"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    style="@style/Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/app_settings" />

                <!-- Down while closed, turned up while open; ends at the card's content edge, where the Play circle
                     ends: ⌄ stops 6dp inside its box. -->
                <ImageView
                    android:id="@+id/settings_chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="-6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_expand" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Appearance only. -->
                <TextView
                    style="@style/Label"
                    android:layout_marginTop="20dp"
                    android:text="@string/appearance" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/appearance_system"
                        style="@style/Segment"
                        android:text="@string/system_default" />

                    <TextView
                        android:id="@+id/appearance_light"
                        style="@style/Segment"
                        android:layout_marginHorizontal="8dp"
                        android:text="@string/light_mode" />

                    <TextView
                        android:id="@+id/appearance_dark"
                        style="@style/Segment"
                        android:text="@string/dark_mode" />
                </LinearLayout>

                <!-- The version and copyright, last in App settings: 28dp below, as between settings, centred, in
                     grey. -->
                <TextView
                    android:id="@+id/copyright"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
